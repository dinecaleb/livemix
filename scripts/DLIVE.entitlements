<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The hardened runtime (required for notarization) refuses the microphone unless the app
         says it wants it. DLIVE reads the console's inputs, so it does. Nothing else: no JIT,
         no unsigned memory, no library validation exemption - the app loads no plug-ins. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
